+        result: Result<Boolean>,
+    ) = runCatching {
+        if (!TdidEvents.enabled) return@runCatching
+        val sessionRef = TdidEvents.local("presentation_session", session.id)
+        val refs = mutableMapOf("session_ref" to sessionRef)
+        val vpToken = tokenResponse.vpToken?.let { if (it is JsonPrimitive) it.content else it.toString() }
+        vpToken?.let { refs["presentation_ref"] = TdidEvents.joint("presentation", it) }
+        (session.authorizationRequest?.state ?: session.id).let { refs["request_ref"] = TdidEvents.joint("request", it) }
