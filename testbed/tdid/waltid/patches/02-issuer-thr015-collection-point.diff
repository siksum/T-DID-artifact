+    private fun tdidIssuanceDecision(
+        credentialRequest: CredentialRequest,
+        session: IssuanceSession,
+        proofCheck: String,
+        response: CredentialResponse?,
+        failure: Throwable?,
+    ) = runCatching {
+        if (!TdidEvents.enabled) return@runCatching
+        val sessionRef = TdidEvents.local("issuance_session", session.id)
+        val refs = mutableMapOf("session_ref" to sessionRef)
+        // full serialized key-proof bytes (jwt or cwt) as received
+        (credentialRequest.proof?.jwt ?: credentialRequest.proof?.cwt)?.let { refs["proof_ref"] = TdidEvents.local("proof", it) }
+        val credential = response?.credential
+        val credentialBytes = when (credential) {
+            null, is JsonNull -> null
+            is JsonPrimitive -> credential.content
+            else -> credential.toString()
+        }
+        credentialBytes?.let { refs["output_ref"] = TdidEvents.local("credential", it) }
+        val (outcome, reason) = when {
+            failure is CredentialError -> "reject" to failure.errorCode.name
+            failure != null -> "error" to (failure::class.simpleName ?: "exception")
+            credentialBytes != null -> "issue" to null
+            else -> "pending" to "deferred"
+        }
+        TdidEvents.emit(
+            eventType = "ISSUANCE_DECISION",
+            workflowRef = "issuer-session:$sessionRef",
+            required = listOf("credential_key_proof_validation"),
+            results = mapOf("credential_key_proof_validation" to proofCheck),
+            outcome = outcome,
+            reason = reason,
+            refs = refs,
+        )
+    }.onFailure { log.error(it) { "T-DID collection point failed" } }
